+
+  searchUsers(term: string, rol?: string, limit: number = 10) {
+    let params = new HttpParams().set('q', term).set('limit', limit);
+
+    if (rol) {
+      params = params.set('rol', rol);
+    }
+
+    return this.http.get<any>(`${this.BASE_URL}/users/search`, { params }).pipe(
+      map((res) => res.data),
+      catchError(() => of([])),
+    );
+  }
 }
